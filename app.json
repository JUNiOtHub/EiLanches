{
  "expo": {
    "name": "EiLanches",
    "slug": "eilanches",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0F0F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stremum.eilanches",
      "infoPlist": {
        "NSCameraUsageDescription": "EiLanches precisa acessar sua câmera para fotos de perfil e documentos",
        "NSLocationWhenInUseUsageDescription": "EiLanches precisa de sua localização para mostrar lojas próximas",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "EiLanches precisa de sua localização para encontrar lojas próximas",
        "NSPhotoLibraryUsageDescription": "EiLanches precisa acessar suas fotos para perfil e documentos",
        "UIStatusBarStyle": "UIStatusBarStyleDarkContent",
        "UIViewControllerBasedStatusBarAppearance": false
      },
      "buildNumber": "1.0.0"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF8C00"
      },
      "package": "com.stremum.eilanches",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "MAIN",
          "category": "LAUNCHER"
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir acesso para foto de perfil"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Precisamos de sua localização para entregas"
        }
      ],
      "expo-notifications",
      "expo-splash-screen",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Inter-Regular.ttf",
            "./assets/fonts/Inter-Bold.ttf",
            "./assets/fonts/Inter-Black.ttf"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a19120d6-3702-478d-aa78-8f9f17a06c7c"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0
    },
    "owner": "jjjunior"
  }
}
